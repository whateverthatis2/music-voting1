{
  "version": 2,
  "builds": [
    {"src": "api/index.py", "use": "@vercel/python"}
  ],
  "routes": [
    {"src": "/healthz",       "dest": "/api/index.py"},
    {"src": "/lab4",          "dest": "/api/index.py"},
    {"src": "/lab5",          "dest": "/api/index.py"},
    {"src": "/data",          "dest": "/api/index.py"},
    {"src": "/distributed",   "dest": "/api/index.py"},
    {"src": "/satisfaction",  "dest": "/api/index.py"},
    {"src": "/large",         "dest": "/api/index.py"},
    {"src": "/protocol",      "dest": "/api/index.py"},
    {"src": "/protocol.txt",  "dest": "/api/index.py"},
    {"src": "/(.*)",          "dest": "/api/index.py"}
  ]
}
